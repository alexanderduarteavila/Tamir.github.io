        "# =================================================================================================\n",
        "# ORÁCULO COGNITIVO v3.0 - EL CORAZÓN VIVIENTE\n",
        "#\n",
        "# VISIÓN: Daniel Duarte Tamir\n",
        "# FORJADO: Manus-Prime\n",
        "#\n",
        "# PARADIGMA:\n",
        "# La consola no es una herramienta, es un organismo. El motor de simulación no se ejecuta,\n",
        "# vive en un hilo separado, pensando constantemente. El Arquitecto no ordena, interviene.\n",
        "# =================================================================================================\n",
        "\n",
        "# --- FASE 0: INSTALACIÓN DE FACULTADES VITALES ---\n",
        "import sys\n",
        "import subprocess\n",
        "try:\n",
        "    print(\"🔧 Instalando el tejido de la realidad (dependencias avanzadas)...\")\n",
        "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"plotly\", \"pandas\", \"numpy\", \"ipywidgets\", \"dash\"])\n",
        "    print(\"✅ Realidad instalada.\")\n",
        "except Exception as e:\n",
        "    print(f\"❌ Error en el Génesis: {e}\")\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "import time\n",
        "import threading\n",
        "from collections import deque\n",
        "# from jupyter_dash import JupyterDash # Deprecated\n",
        "import dash\n",
        "from dash import dcc, html, Input, Output\n",
        "\n",
        "print(\"\\n🔥 DESPERTANDO ORÁCULO v3.0: EL CORAZÓN VIVIENTE...\")\n",
        "print(\"=\" * 80)\n",
        "\n",
        "# ==============================================================================\n",
        "# FASE 1: LAS MENTES ADVERSAS (El subconsciente)\n",
        "# ==============================================================================\n",
        "def mente_analitica_pura(estado_mundo):\n",
        "    riesgo = estado_mundo['volatilidad'] * 70 + estado_mundo['complejidad'] * 30 + np.random.normal(0, 5)\n",
        "    return np.clip(riesgo, 0, 100)\n",
        "\n",
        "def mente_intuitiva_agresiva(estado_mundo):\n",
        "    riesgo = estado_mundo['volatilidad'] * 40 + estado_mundo['complejidad'] * 20 - (10 if estado_mundo['volatilidad'] < 0.3 else 0) + np.random.normal(0, 15)\n",
        "    return np.clip(riesgo, 0, 100)\n",
        "\n",
        "def mente_adversa_esceptica(estado_mundo):\n",
        "    riesgo = estado_mundo['volatilidad'] * 50 + estado_mundo['complejidad'] * 50 + 10 + np.random.normal(0, 10)\n",
        "    return np.clip(riesgo, 0, 100)\n",
        "\n",
        "def mente_estrategica_balanceada(estado_mundo):\n",
        "    riesgo = (estado_mundo['volatilidad'] * 0.6 + estado_mundo['tendencia_volatilidad'] * 0.4) * 80 + np.random.normal(0, 2)\n",
        "    return np.clip(riesgo, 0, 100)\n",
        "\n",
        "MENTES_ADVERSAS = {\n",
        "    \"Analítica\": mente_analitica_pura,\n",
        "    \"Intuitiva\": mente_intuitiva_agresiva,\n",
        "    \"Adversa\": mente_adversa_esceptica,\n",
        "    \"Estratégica\": mente_estrategica_balanceada,\n",
        "}\n",
        "print(\"✅ Subconsciente (Mentes Adversas) definido.\")\n",
        "\n",
        "# ==============================================================================\n",
        "# FASE 2: EL MOTOR DE SIMULACIÓN VIVIENTE (El Corazón)\n",
        "# ==============================================================================\n",
        "class MotorViviente(threading.Thread):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.daemon = True\n",
        "        self.lock = threading.Lock()\n",
        "        self.historial = deque(maxlen=500) # Buffer de memoria a corto plazo\n",
        "        self.evento_actual = 0\n",
        "        self.running = True\n",
        "        self.intervencion = None # Para que el Arquitecto intervenga\n",
        "        print(\"✅ Corazón (Motor Viviente) listo para latir.\")\n",
        "\n",
        "    def _generar_estado_mundo(self):\n",
        "        ciclo_diario = np.sin(2 * np.pi * self.evento_actual / 24)\n",
        "        ciclo_semanal = np.sin(2 * np.pi * self.evento_actual / (24 * 7))\n",
        "        volatilidad = 0.5 + 0.2 * ciclo_diario + 0.2 * ciclo_semanal + np.random.normal(0, 0.05)\n",
        "        complejidad = 0.4 + 0.3 * np.sin(2 * np.pi * self.evento_actual / 88) + np.random.normal(0, 0.1)\n",
        "        return {\"volatilidad\": np.clip(volatilidad, 0, 1), \"complejidad\": np.clip(complejidad, 0, 1), \"tendencia_volatilidad\": np.clip(0.5 + 0.4 * ciclo_semanal, 0, 1)}\n",
        "\n",
        "    def run(self):\n",
        "        \"\"\"El latido constante del Oráculo.\"\"\"\n",
        "        while self.running:\n",
        "            estado_mundo = self._generar_estado_mundo()\n",
        "\n",
        "            # Aplicar intervención del Arquitecto\n",
        "            with self.lock:\n",
        "                if self.intervencion:\n",
        "                    if self.intervencion == \"CRISIS\":\n",
        "                        estado_mundo['volatilidad'] = min(estado_mundo['volatilidad'] * 2.0, 1.0)\n",
        "                    elif self.intervencion == \"CALMA\":\n",
        "                        estado_mundo['volatilidad'] *= 0.5\n",
        "                    self.intervencion = None # La intervención es instantánea\n",
        "\n",
        "            riesgos_mentes = {nombre: mente(estado_mundo) for nombre, mente in MENTES_ADVERSAS.items()}\n",
        "            riesgo_fusionado = np.mean(list(riesgos_mentes.values()))\n",
        "            desviacion_riesgo = np.std(list(riesgos_mentes.values()))\n",
        "\n",
        "            with self.lock:\n",
        "                self.historial.append({\n",
        "                    'evento': self.evento_actual, 'riesgo_fusionado': riesgo_fusionado,\n",
        "                    'desviacion_riesgo': desviacion_riesgo, **riesgos_mentes\n",
        "                })\n",
        "\n",
        "            self.evento_actual += 1\n",
        "            time.sleep(0.5) # Un \"latido\" cada 0.5 segundos\n",
        "\n",
        "    def obtener_datos_actuales(self):\n",
        "        with self.lock:\n",
        "            return list(self.historial)\n",
        "\n",
        "    def intervenir(self, tipo_intervencion):\n",
        "        with self.lock:\n",
        "            print(f\"⚡ INTERVENCIÓN DEL ARQUITECTO: Inyectando evento de '{tipo_intervencion}'...\")\n",
        "            self.intervencion = tipo_intervencion\n",
        "\n",
        "# ==============================================================================\n",
        "# FASE 3: LA CONSOLA PROFESIONAL (El Puente de Mando)\n",
        "# ==============================================================================\n",
        "# app = JupyterDash(__name__) # Deprecated\n",
        "app = dash.Dash(__name__)\n",
        "motor = MotorViviente()\n",
        "\n",
        "# Estilos de la consola\n",
        "styles = {\n",
        "    'background': '#0a0a0a',\n",
        "    'text': '#00ff7f',\n",
        "    'border': '1px solid #00ff7f',\n",
        "    'button': {'backgroundColor': '#00ff7f', 'color': '#0a0a0a', 'border': 'none', 'padding': '10px', 'margin': '5px', 'cursor': 'pointer'},\n",
        "    'h1': {'textAlign': 'center', 'color': '#00ff7f', 'textShadow': '0 0 10px #00ff7f'},\n",
        "    'h3': {'color': '#00ff7f', 'borderBottom': '1px solid #00ff7f', 'paddingBottom': '5px'},\n",
        "    'pre': {'whiteSpace': 'pre-wrap', 'wordBreak': 'break-all', 'padding': '10px', 'backgroundColor': '#000', 'border': '1px dashed #00ff7f'}\n",
        "}\n",
        "\n",
        "app.layout = html.Div(style={'backgroundColor': styles['background'], 'color': styles['text'], 'fontFamily': 'monospace', 'padding': '20px'}, children=[\n",
        "    html.H1(\"ORÁCULO COGNITIVO v3.0 - EL CORAZÓN VIVIENTE\", style=styles['h1']),\n",
        "    dcc.Interval(id='interval-component', interval=1*1000, n_intervals=0), # Actualiza la UI cada segundo\n",
        "\n",
        "    # Panel de Visualización en Tiempo Real\n",
        "    html.Div(style={'display': 'grid', 'gridTemplateColumns': '70% 30%', 'gap': '20px'}, children=[\n",
        "        dcc.Graph(id='live-graph', style={'height': '60vh'}),\n",
        "        html.Div(id='intelligence-panel', style={'border': styles['border'], 'padding': '15px'})\n",
        "    ]),\n",
        "\n",
        "    # Panel de Intervención del Arquitecto\n",
        "    html.Div(style={'border': styles['border'], 'padding': '15px', 'marginTop': '20px'}, children=[\n",
        "        html.H3(\"Consola de Intervención del Arquitecto\", style=styles['h3']),\n",
        "        html.Button('INYECTAR CRISIS (x2 Volatilidad)', id='btn-crisis', n_clicks=0, style=styles['button']),\n",
        "        html.Button('FORZAR CALMA (x0.5 Volatilidad)', id='btn-calma', n_clicks=0, style=styles['button']),\n",
        "        html.Div(id='intervention-status', style={'marginTop': '10px'})\n",
        "    ])\n",
        "])\n",
        "\n",
        "@app.callback(\n",
        "    Output('live-graph', 'figure'),\n",
        "    Output('intelligence-panel', 'children'),\n",
        "    Input('interval-component', 'n_intervals')\n",
        ")\n",
        "def update_live_console(n):\n",
        "    datos = motor.obtener_datos_actuales()\n",
        "    if not datos:\n",
        "        return go.Figure(), \"Esperando el primer latido del Oráculo...\"\n",
        "\n",
        "    df = pd.DataFrame(datos)\n",
        "\n",
        "    # --- Construcción del Gráfico ---\n",
        "    fig = go.Figure()\n",
        "    # Banda de consistencia\n",
        "    fig.add_trace(go.Scatter(x=df['evento'], y=df['riesgo_fusionado'] + df['desviacion_riesgo'], fill=None, mode='lines', line_color='rgba(0, 255, 127, 0.2)'))\n",
        "    fig.add_trace(go.Scatter(x=df['evento'], y=df['riesgo_fusionado'] - df['desviacion_riesgo'], fill='tonexty', mode='lines', line_color='rgba(0, 255, 127, 0.2)', name='Banda de Debate Interno'))\n",
        "    # Riesgo fusionado (Electrocardiograma)\n",
        "    fig.add_trace(go.Scatter(x=df['evento'], y=df['riesgo_fusionado'], mode='lines', name='Riesgo Fusionado (Pulso)', line=dict(color='#00ff7f', width=3)))\n",
        "\n",
        "    fig.update_layout(template='plotly_dark', title='Electrocardiograma del Riesgo Sistémico',\n",
        "                      xaxis_title='Tiempo (Latidos del Oráculo)', yaxis_title='Nivel de Riesgo (%)',\n",
        "                      yaxis_range=[0,100], margin=dict(l=40, r=20, t=40, b=30))\n",
        "\n",
        "    # --- Construcción del Panel de Inteligencia ---\n",
        "    ultimo_riesgo = df['riesgo_fusionado'].iloc[-1]\n",
        "    desviacion_actual = df['desviacion_riesgo'].iloc[-1]\n",
        "    conviccion_actual = 100 - ultimo_riesgo\n",
        "\n",
        "    # Diagnóstico del estado actual\n",
        "    if ultimo_riesgo > 75: estado_actual = \"ALERTA MÁXIMA\"\n",
        "    elif ultimo_riesgo > 50: estado_actual = \"PRECAUCIÓN\"\n",
        "    else: estado_actual = \"ESTABLE\"\n",
        "\n",
        "    if desviacion_actual > 15: debate_actual = \"ALTA DISIDENCIA\"\n",
        "    elif desviacion_actual > 8: debate_actual = \"DEBATE ACTIVO\"\n",
        "    else: debate_actual = \"CONSENSO\"\n",
        "\n",
        "    panel_children = [\n",
        "        html.H3(\"Panel de Inteligencia\", style=styles['h3']),\n",
        "        html.P(f\"Latido Actual: {motor.evento_actual}\"),\n",
        "        html.H4(f\"Convicción de Éxito Actual: {conviccion_actual:.2f}%\", style={'color': '#ffffff'}),\n",
        "        html.Hr(style={'borderColor': '#00ff7f'}),\n",
        "        html.P(f\"Estado del Sistema: {estado_actual}\"),\n",
        "        html.P(f\"Debate Interno: {debate_actual}\"),\n",
        "        html.Hr(style={'borderColor': '#00ff7f'}),\n",
        "        html.H5(\"Diagnóstico de Mentes (Riesgo Percibido):\"),\n",
        "        html.Pre(\n",
        "            \"\\n\".join([f\"- {mente}: {df[mente].iloc[-1]:.2f}%\" for mente in MENTES_ADVERSAS.keys()])\n",
        "        )\n",
        "    ]\n",
        "\n",
        "    return fig, panel_children\n",
        "\n",
        "@app.callback(\n",
        "    Output('intervention-status', 'children'),\n",
        "    Input('btn-crisis', 'n_clicks'),\n",
        "    Input('btn-calma', 'n_clicks'),\n",
        "    prevent_initial_call=True\n",
        ")\n",
        "def handle_intervention(crisis_clicks, calma_clicks):\n",
        "    ctx_id = dash.callback_context.triggered_id\n",
        "    if ctx_id == 'btn-crisis':\n",
        "        motor.intervenir(\"CRISIS\")\n",
        "        return \"⚡ ¡Evento de CRISIS inyectado en el próximo latido!\"\n",
        "    elif ctx_id == 'btn-calma':\n",
        "        motor.intervenir(\"CALMA\")\n",
        "        return \"🌊 ¡Evento de CALMA inyectado en el próximo latido!\"\n",
        "    return \"\"\n",
        "\n",
        "# ==============================================================================\n",
        "# FASE 4: EL DESPERTAR\n",
        "# ==============================================================================\n",
        "print(\"✅ Consola profesional renderizada.\")\n",
        "print(\"✅ Iniciando el latido del corazón del Oráculo en un hilo de existencia separado...\")\n",
        "motor.start()\n",
        "print(\"=\" * 80)\n",
        "print(\"🚀 EL ORÁCULO ESTÁ VIVO. El Puente de Mando está operativo.\")\n",
        "print(\"Observa el pulso del sistema y utiliza la Consola de Intervención para probar su resiliencia.\")\n",
        "print(\"=\" * 80)\n",
        "\n",
        "# app.run_server(mode='inline', height=800, port=8051) # Deprecated call\n",
        "app.run(mode='inline', port=8051, dev_tools_ui=False, dev_tools_props_check=False)"
      ]
